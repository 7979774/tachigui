# クライアントごとの通信量 (LAN と WAN の間を通る分) を数える。クライアント画面の「転送速度」「トラフィック」に使う。
# 何度読み込まれても重ならないよう、いったん消してから作る。
add table inet tachigui_acct
delete table inet tachigui_acct
table inet tachigui_acct {
	set tx4 { type ipv4_addr; flags dynamic; size 2048; timeout 1d; counter; }
	set rx4 { type ipv4_addr; flags dynamic; size 2048; timeout 1d; counter; }
	set tx6 { type ipv6_addr; flags dynamic; size 4096; timeout 1d; counter; }
	set rx6 { type ipv6_addr; flags dynamic; size 4096; timeout 1d; counter; }
	chain count {
		type filter hook forward priority -5; policy accept;
		iifname "br-lan" oifname != "br-lan" meta nfproto ipv4 update @tx4 { ip saddr }
		iifname != "br-lan" oifname "br-lan" meta nfproto ipv4 update @rx4 { ip daddr }
		iifname "br-lan" oifname != "br-lan" meta nfproto ipv6 update @tx6 { ip6 saddr }
		iifname != "br-lan" oifname "br-lan" meta nfproto ipv6 update @rx6 { ip6 daddr }
	}
}
